RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=propertyfinder-uae-data.p.rapidapi.com
# UAE Real Estate 2 — locations_search (and future property detail with developer, etc.)
RAPIDAPI_HOST_UAE_REAL_ESTATE2=uae-real-estate2.p.rapidapi.com
OPENAI_API_KEY=your_openai_api_key_here
# AgentZero WhatsApp replies + email drafts
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_payment_link
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_hook_path

# Transaction Explorer: set to true to disable the premium blur/paywall (full charts). Omit or false in production.
# NEXT_PUBLIC_TRANSACTIONS_FULL_ACCESS=true

# Sterling Boulevard /onboard login (do not commit real values)
ONBOARD_AUTH_USERNAME=
ONBOARD_AUTH_PASSWORD=
ONBOARD_AUTH_SECRET=

# Meta WhatsApp Cloud API (AgentZero coexistence)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
# Dev only: skip Meta webhook signature verification
SKIP_META_SIG=1
# Optional seed override for scripts/seed-tenant.mjs
SEED_AGENT_WA_ID=
SEED_AGENT_NAME=

# 1416 Real Estate Vapi calling pipeline
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Jarvis WhatsApp message-relay assistant (customerName + task variables)
VAPI_RELAY_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
LEADS_INBOUND_SECRET=
RESULTS_WEBHOOK_URL=
# ghl-courses only (Zapier Catch Hook → Google Sheet). Does not use RESULTS_WEBHOOK_URL.
RESULTS_WEBHOOK_URL_GHL_COURSES=
CALLS_BUSINESS_HOURS_START=9
CALLS_BUSINESS_HOURS_END=20

# Operations Copilot login (/copilot) — do not commit real values
# Preferred: multi-user JSON. Each user is locked to one tenants.slug.
# COPILOT_USERS_JSON=[{"username":"Salmaan","password":"...","tenantSlug":"condo-city"},{"username":"Naheem","password":"...","tenantSlug":"1416"},{"username":"ghl","password":"...","tenantSlug":"ghl-courses"}]
COPILOT_USERS_JSON=
# Fallback when COPILOT_USERS_JSON is unset (single shared user):
COPILOT_USERNAME=
COPILOT_PASSWORD=
# Tenant slug for the fallback single user (default 1416)
COPILOT_HOME_TENANT=1416
# Long random string for signing session cookies (e.g. `openssl rand -hex 32`)
COPILOT_SESSION_SECRET=

# Jarvis chat (/jarvis) — shared access key sent as x-jarvis-key header.
# Unset = open in dev, locked in production. Set a long random string on Railway.
JARVIS_ACCESS_KEY=
# Comma-separated WhatsApp wa_ids (digits only) that hit the Jarvis engine
# on the Sterling AZ Twilio number instead of the static KB.
# Example: JARVIS_WHATSAPP_WA_IDS=971585690693
JARVIS_WHATSAPP_WA_IDS=
# tenants.slug for Jarvis workspace (default: sterling)
JARVIS_TENANT_SLUG=sterling

# Twilio REST (required on Vercel for async Jarvis WhatsApp replies).
# Webhook still uses TwiML; final Jarvis answers are sent via messages.create.
# From/To come from the inbound webhook — do not hardcode the Sterling number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Whautomate coexistence adapter (optional secret; unset = accept all, dev mode)
WHAUTOMATE_WEBHOOK_SECRET=

# Whautomate outbound send + auto-reply (default OFF)
WHAUTOMATE_API_KEY=
WHAUTOMATE_API_BASE=https://api.whautomate.com
WHAUTOMATE_LOCATION_ID=
WHAUTOMATE_AUTOREPLY=false
